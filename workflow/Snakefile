# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
SCRIPTSDIR = config["scriptsdir"]

# Get sample
SAMPLE = config["sample"]
CASE = config["case"]
PATIENT = config["patient"]

# Get fastq location
manifest = pd.read_table(config["manifest"])
fastqs = manifest['New'].tolist()

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Define genomes
genome = config['genome']

# Rules
localrules: link_raw

rule all:
    input:
        # Link fastqs
        expand(join(RESULTSDIR, "biomodal", "nf-input", "{fastq}"),fastq=fastqs),
        
        # Biomodal
        join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","bams",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
        join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","variant_call_files","germline",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz"),

        # CNVkit
        join(RESULTSDIR, "cnvkit", f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup-scatter.png"),

        # OpenCravat
        join(RESULTSDIR, "Oncogenomics", PATIENT, CASE, PATIENT, "db", f"{PATIENT}.variants"),

        # ichorCNA
        join(RESULTSDIR, "ichorCNA", f"{SAMPLE}.10000.wig"),
        join(RESULTSDIR, "ichorCNA", f"{SAMPLE}.params.txt")

rule link_raw:
    """
    Link fastqs from storage to Biomodal nf-input, renaming multiple flowcells as lanes
    """
    input:
        manifest = config["manifest"]
    output:
        fastq = expand(join(RESULTSDIR, "biomodal", "nf-input", "{fastq}"),fastq=fastqs)
    params:
        outdir = join(RESULTSDIR, "biomodal", "nf-input")
    shell:
        """
        while read old new
        do
            ln -s $old {params.outdir}/$new
        done < <(tail -n +2 {input.manifest})
        """

rule biomodal:
    """
    Run Biomodal evoC analysis pipeline
    """
    input:
        fastq = [join(RESULTSDIR, "biomodal", "nf-input", new) for new in manifest['New']]
    output:
        bam = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","bams",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
        vcf = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","variant_call_files","germline",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz")
    params:
        sample = SAMPLE,
        output = join(RESULTSDIR, "biomodal")
    envmodules:
        TOOLS["biomodal"]
    shell:
        """
        biomodal analyse --work-dir {params.output}/nf-work \
            --input-path {params.output} \
            --output-path {params.output} \
            --additional-profile super_seq \
            --tag {params.sample} --mode 6bp
        """

rule cnvkit:
    """
    Run CNVkit on biomodal evoC bam files with flat reference
    """
    input:
        bam = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","bams",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
    output:
        png = join(RESULTSDIR, "cnvkit", f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup-scatter.png")
    envmodules:
        TOOLS["cnvkit"],
        TOOLS["samtools"]
    params:
        output = join(RESULTSDIR, "cnvkit"),
        fasta = config[genome]['fasta'],
        refflat = config[genome]['refflat']
    threads:
        getthreads("cnvkit")
    shell:
        """
        cnvkit.py batch {input.bam} -n -p {threads} -m wgs --fasta {params.fasta} --output-dir {params.output} --annotate {params.refflat} --scatter
        """

rule opencravat:
    """
    Run OpenCravat variant annotation and filtering on GATK HaplotypeCaller VCF using Vineela's NextFlow workflow
    """
    input:
        vcf = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","variant_call_files","germline",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz"),
        bam = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","bams",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.bam")
    output:
        db = join(RESULTSDIR, "Oncogenomics", PATIENT, CASE, PATIENT, "db", f"{PATIENT}.variants")
    params:
        sample = SAMPLE,
        case = CASE,
        patient = PATIENT,
        output = join(RESULTSDIR, "Oncogenomics"),
        pipeline_loc = config["oncogenomics_nf"],
        vcf_unzipped = temp(join(RESULTSDIR, "Oncogenomics", PATIENT, CASE, f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.vcf")),
        samplesheet = join(RESULTSDIR, "Oncogenomics", PATIENT, CASE, f"{SAMPLE}.samplesheet.csv")
    envmodules:
        TOOLS["nextflow"],
        TOOLS["annovar"]
    shell:
        """
        # Unzip VCF for OpenCravat
        gunzip -c {input.vcf} > {params.vcf_unzipped}
        
        # Create samplesheet with unzipped VCF
        echo -e "patient,sample,casename,vcf,bam\n{params.patient},{params.sample},{params.case},{params.vcf_unzipped},{input.bam}" > {params.samplesheet}

        # Run OpenCravat workflow
        nextflow run {params.pipeline_loc}/main.nf \
            -c {params.pipeline_loc}/nextflow.config \
            --input_samplesheet {params.samplesheet} \
            --resultsdir {params.output} \
            -profile biowulf \
            --modules_oc /data/khanlab/projects/ngs_pipeline_testing/opencravat/oc_vg_2.13_install/lib/python3.9/site-packages/cravat/modules \
            -resume
        """

rule hmmcopy:
    """
    Generate WIG file from biomodal evoC bam
    """
    input:
        bam = join(RESULTSDIR, "biomodal", "nf-results", f"duet-1.4.1_{SAMPLE}_6bp","sample_outputs","bams",f"{SAMPLE}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
    output:
        wig = join(RESULTSDIR, "ichorCNA", f"{SAMPLE}.10000.wig")
    params:
        window = 10000
    shell:
        """
        /data/khanlab3/gb_omics/software/hmmcopy_utils/bin/readCounter \
                --window {params.window} --quality 20 \
                --chromosome "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY" \
                {input.bam} > {output.wig}
        """

rule ichorCNA:
    """
    Run ichorCNA on WIG file
    """
    input:
        wig = join(RESULTSDIR, "ichorCNA", f"{SAMPLE}.10000.wig")
    output:
        purity = join(RESULTSDIR, "ichorCNA", f"{SAMPLE}.params.txt")
    params:
        ichor_scripts = config["ichorCNA_scripts"],
        ichor_extdata = config["ichorCNA_extdata"],
        outdir = join(RESULTSDIR, "ichorCNA"),
        sample = SAMPLE
    envmodules:
        TOOLS["R"]
    shell:
        """
        Rscript {params.ichor_scripts}/runIchorCNA.R --id {params.sample} \
            --WIG {input.wig} --ploidy 'c(2,3)' --normal 'c(0.5,0.6,0.7,0.8,0.9,0.95,0.99)' --maxCN 5  \
            --gcWig {params.ichor_extdata}/gc_hg38_10kb.wig \
            --mapWig {params.ichor_extdata}/map_hg38_10kb.wig \
            --centromere {params.ichor_extdata}/GRCh38.GCA_000001405.2_centromere_acen.txt \
            --includeHOMD True --chrs 'c(1:22, \"X\")' --chrTrain 'c(1:22)' --normalizeMaleX True \
            --estimateNormal True --estimatePloidy True --estimateScPrevalence True \
            --scStates 'c(1,3)' --txnE 0.9999 --txnStrength 10000 --outDir {params.outdir}
            #--normalPanel {params.ichor_extdata}/HD_ULP_PoN_hg38_500kb_median_normAutosome_median.rds \
        """
