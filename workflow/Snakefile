# Import python libraries
import os
from os.path import join
import itertools
import yaml
import pandas as pd

# Set directories
WORKDIR = config["workdir"]
RESULTSDIR = join(WORKDIR,"results")
SCRIPTSDIR = config["scriptsdir"]

# Get sample
SAMPLE = config["sample"]

# Get fastq location
manifest = pd.read_table(config["manifest"])
fastqs = manifest['New'].tolist()

# Define tools
with open(config["tools"]) as f:
    TOOLS = yaml.safe_load(f)

# Define resources per rule
with open(config["cluster"]) as f:
    CLUSTER = yaml.safe_load(f)

getthreads=lambda rname:int(CLUSTER[rname]["threads"]) if rname in CLUSTER and "threads" in CLUSTER[rname] else int(CLUSTER["__default__"]["threads"])
getmemg=lambda rname:CLUSTER[rname]["mem"] if rname in CLUSTER and "mem" in CLUSTER[rname] else CLUSTER["__default__"]["mem"]

# Define genomes
genome = config['genome']

# Rules
localrules: link_raw

rule all:
    input:
        # Link fastqs
        expand(join(RESULTSDIR, "biomodal", "nf-input", "{fastq}"),fastq=fastqs),
        
        # Biomodal
        expand(join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","bams","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),sample=[SAMPLE]),
        expand(join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","variant_call_files","germline","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz"),sample=[SAMPLE]),

        # CNVkit
        expand(join(RESULTSDIR, "cnvkit", "{sample}.genome.GRCh38Decoy_primary_assembly.dedup-scatter.png"),sample=[SAMPLE]),

        # OpenCravat
        expand(join(RESULTSDIR, "OpenCravat", "{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz.tsv"),sample=[SAMPLE]),
        expand(join(RESULTSDIR, "OpenCravat", "{sample}.all_annotations.txt"),sample=[SAMPLE]),
        expand(join(RESULTSDIR, "OpenCravat", "{sample}.rare_annotation.tsv"),sample=[SAMPLE]),

        # ichorCNA
        expand(join(RESULTSDIR, "ichorCNA", "{sample}.10000.wig"),sample=[SAMPLE]),
        expand(join(RESULTSDIR, "ichorCNA", "{sample}.params.txt"),sample=[SAMPLE])

rule link_raw:
    """
    Link fastqs from storage to Biomodal nf-input, renaming multiple flowcells as lanes
    """
    input:
        manifest = config["manifest"]
    output:
        fastq = expand(join(RESULTSDIR, "biomodal", "nf-input", "{fastq}"),fastq=fastqs)
    params:
        outdir = join(RESULTSDIR, "biomodal", "nf-input")
    shell:
        """
        while read old new
        do
            ln -s $old {params.outdir}/$new
        done < <(tail -n +2 {input.manifest})
        """

rule biomodal:
    """
    Run Biomodal evoC analysis pipeline
    """
    input:
        fastq = [join(RESULTSDIR, "biomodal", "nf-input", new) for new in manifest['New']]
    output:
        bam = join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","bams","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
        vcf = join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","variant_call_files","germline","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz")
    params:
        sample = "{sample}",
        output = join(RESULTSDIR, "biomodal")
    envmodules:
        TOOLS["biomodal"]
    shell:
        """
        biomodal analyse --work-dir {params.output}/nf-work \
            --input-path {params.output} \
            --output-path {params.output} \
            --additional-profile super_seq \
            --tag {params.sample} --mode 6bp
        """

rule cnvkit:
    """
    Run CNVkit on biomodal evoC bam files with flat reference
    """
    input:
        bam = join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","bams","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
    output:
        png = join(RESULTSDIR, "cnvkit", "{sample}.genome.GRCh38Decoy_primary_assembly.dedup-scatter.png")
    envmodules:
        TOOLS["cnvkit"],
        TOOLS["samtools"]
    params:
        output = join(RESULTSDIR, "cnvkit"),
        fasta = config[genome]['fasta'],
        refflat = config[genome]['refflat']
    threads:
        getthreads("cnvkit")
    shell:
        """
        cnvkit.py batch {input.bam} -n -p {threads} -m wgs --fasta {params.fasta} --output-dir {params.output} --annotate {params.refflat} --scatter
        """

rule opencravat:
    """
    Run OpenCravat 2.13.0 on VCF files
    """
    input:
        vcf = join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","variant_call_files","germline","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz")
    output:
        variants = join(RESULTSDIR, "OpenCravat", "{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz.tsv")
    params:
        output = join(RESULTSDIR, "OpenCravat")
    threads:
        getthreads("opencravat")-1
    shell:
        """
        #export PYTHONPATH="/data/khanlab/projects/ngs_pipeline_testing/opencravat/oc_vg_2.13_install:$PYTHONPATH"

        echo "Running OpenCRAVAT 2.13.0 analysis"
        echo "Input VCF: {input.vcf}"
        echo "Genome build: hg38 (GRCh38)"
        echo "Annotators: gnomad3, gnomad4"

        /data/khanlab/projects/ngs_pipeline_testing/opencravat/oc_vg_2.13_install/bin/oc run \
        {input.vcf} \
        -l hg38 \
        -a gnomad3 \
        --mp {threads} \
        -t text \
        -d {params.output}
        """

rule filter_variants:
    """
    Filter OpenCravat output
    """
    input:
        variants = join(RESULTSDIR, "OpenCravat", "{sample}.genome.GRCh38Decoy_primary_assembly.dedup.vcf.gz.tsv")
    output:
        all_output = join(RESULTSDIR, "OpenCravat", "{sample}.all_annotations.txt"),
        rare_output = join(RESULTSDIR, "OpenCravat", "{sample}.rare_annotation.tsv")
    params:
        sample = "{sample}"
    shell:
        """
        python /data/khanlab/projects/Nextflow_dev/dev/vg_dev/Oncogenomics_NF_WF/bin/filter_opencravat_output.py \
                --sample-id {params.sample} \
                --all-output {output.all_output} \
                --rare-output {output.rare_output} \
                --maf-cutoff 0.05 \
                {input.variants}
        """

rule hmmcopy:
    """
    Generate WIG file from biomodal evoC bam
    """
    input:
        bam = join(RESULTSDIR, "biomodal", "nf-results", "duet-1.4.1_{sample}_6bp","sample_outputs","bams","{sample}.genome.GRCh38Decoy_primary_assembly.dedup.bam"),
    output:
        wig = join(RESULTSDIR, "ichorCNA", "{sample}.10000.wig")
    params:
        window = 10000
    shell:
        """
        /data/khanlab3/gb_omics/software/hmmcopy_utils/bin/readCounter \
                --window {params.window} --quality 20 \
                --chromosome "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY" \
                {input.bam} > {output.wig}
        """

rule ichorCNA:
    """
    Run ichorCNA on WIG file
    """
    input:
        wig = join(RESULTSDIR, "ichorCNA", "{sample}.10000.wig")
    output:
        purity = join(RESULTSDIR, "ichorCNA", "{sample}.params.txt")
    params:
        ichor_scripts = config["ichorCNA_scripts"],
        ichor_extdata = config["ichorCNA_extdata"],
        outdir = join(RESULTSDIR, "ichorCNA"),
        sample = "{sample}"
    envmodules:
        TOOLS["R"]
    shell:
        """
        Rscript {params.ichor_scripts}/runIchorCNA.R --id {params.sample} \
            --WIG {input.wig} --ploidy 'c(2,3)' --normal 'c(0.5,0.6,0.7,0.8,0.9,0.95,0.99)' --maxCN 5  \
            --gcWig {params.ichor_extdata}/gc_hg38_10kb.wig \
            --mapWig {params.ichor_extdata}/map_hg38_10kb.wig \
            --centromere {params.ichor_extdata}/GRCh38.GCA_000001405.2_centromere_acen.txt \
            --includeHOMD True --chrs 'c(1:22, \"X\")' --chrTrain 'c(1:22)' --normalizeMaleX True \
            --estimateNormal True --estimatePloidy True --estimateScPrevalence True \
            --scStates 'c(1,3)' --txnE 0.9999 --txnStrength 10000 --outDir {params.outdir}
            #--normalPanel {params.ichor_extdata}/HD_ULP_PoN_hg38_500kb_median_normAutosome_median.rds \
        """